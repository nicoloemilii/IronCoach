# Copy to .env on the server only. Never commit filled credentials.
IRON_MODE=hosted
IRON_DOMAIN=
IRON_PUBLIC_URL=
IRON_ACME_EMAIL=
IRON_DATA_DIR=/data
IRON_AUTO_SYNC=1
# Generate each independently with python -m app.commercial.cli keygen
IRON_VAULT_KEY=
IRON_BACKUP_KEY=
# Start invite-only. Public registration also requires working SMTP and legal pages.
IRON_REGISTRATION_OPEN=0
IRON_PRIVACY_URL=
IRON_TERMS_URL=
IRON_LEGAL_VERSION=
IRON_SUPPORT_EMAIL=
IRON_SMTP_HOST=
IRON_SMTP_PORT=587
IRON_SMTP_USER=
IRON_SMTP_PASSWORD=
IRON_MAIL_FROM=
# Enable only after test-mode checkout, renewal, cancellation and webhook checks.
IRON_BILLING_REQUIRED=0
IRON_TRIAL_DAYS=14
IRON_STRIPE_SECRET_KEY=
IRON_STRIPE_WEBHOOK_SECRET=
IRON_STRIPE_PRICE_ID=
